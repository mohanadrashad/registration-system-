generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── NextAuth Models ───

model User {
  id               String        @id @default(cuid())
  name             String?
  email            String        @unique
  emailVerified    DateTime?
  password         String
  image            String?
  role             UserRole      @default(VIEWER)
  accounts         Account[]
  sessions         Session[]
  eventMemberships EventMember[]
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  // Admin-edit audit-trail inverse relations. Nullable on the owning
  // model so a deleted User leaves the audit slot null (Prisma default
  // SetNull for optional FKs); we never want a User deletion to
  // cascade-delete a Contact or Registration row.
  contactsUpdated       Contact[]      @relation(name: "ContactUpdater")
  registrationsUpdated  Registration[] @relation(name: "RegistrationUpdater")
  registrationsApproved Registration[] @relation(name: "RegistrationApprover")
  registrationsRejected Registration[] @relation(name: "RegistrationRejecter")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

enum UserRole {
  VIEWER
  EDITOR
  MANAGER
  SUPER_ADMIN
}

// ─── Event ───

model Event {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?  @db.Text
  venue       String?
  startDate   DateTime
  endDate     DateTime
  isActive    Boolean  @default(true)
  capacity    Int? // Max registrations (null = unlimited)
  settings    Json?
  categories  String[] @default([])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  contacts         Contact[]
  registrations    Registration[]
  emailTemplates   EmailTemplate[]
  emailCampaigns   EmailCampaign[]
  badgeTemplate    BadgeTemplate?
  modules          EventModules?
  formFields       FormField[]
  emailSettings    EventEmailSettings?
  checkIns         CheckIn[]
  checkInPoints    CheckInPoint[]
  whatsAppSettings EventWhatsAppSettings?
  whatsAppLogs     WhatsAppLog[]
  branding         EventBranding?
  domain           EventDomain?
  members          EventMember[]
  phases           Phase[]
}

// ─── Event Access (per-event membership) ───

model EventMember {
  id        String   @id @default(cuid())
  userId    String
  eventId   String
  role      UserRole @default(VIEWER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([userId, eventId])
  @@index([eventId])
  @@index([userId])
}

// ─── Event Modules (Feature Toggles) ───

model EventModules {
  id      String @id @default(cuid())
  eventId String @unique

  // Optional Modules (all default to false except formBuilder)
  formBuilder       Boolean @default(true) // Dynamic form fields (core, but toggleable)
  checkIn           Boolean @default(false) // QR check-in system
  whatsApp          Boolean @default(false) // WhatsApp notifications
  sessions          Boolean @default(false) // Agenda/session management
  payments          Boolean @default(false) // Payment collection
  selfServicePortal Boolean @default(false) // Attendee self-service
  approvalWorkflow  Boolean @default(false) // Manual registration approval
  waitlist          Boolean @default(false) // Waitlist when capacity reached
  multiLanguage     Boolean @default(false) // AR/EN form toggle
  customDomain      Boolean @default(false) // Custom domain support
  customEmail       Boolean @default(false) // Custom SMTP per event
  webhooks          Boolean @default(false) // External integrations
  postRegPhases     Boolean @default(true) // Post-registration data collection phases (incl. selectable options)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
}

// ─── Event Email Settings ───

model EventEmailSettings {
  id      String @id @default(cuid())
  eventId String @unique

  provider  EmailProvider @default(SYSTEM)
  fromName  String // "AlUla Conference Team"
  fromEmail String // "register@alula.sa"
  replyTo   String?

  // Custom SMTP
  smtpHost     String?
  smtpPort     Int?
  smtpUser     String?
  smtpPassword String? // Should be encrypted in production
  smtpSecure   Boolean @default(true)

  // Provider API Keys (Resend, SendGrid, etc.)
  apiKey String? // Should be encrypted in production

  // Verification
  isVerified Boolean   @default(false)
  verifiedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
}

enum EmailProvider {
  SYSTEM // Use system default SMTP
  CUSTOM_SMTP // Custom SMTP server
  RESEND // Resend API
  SENDGRID // SendGrid API
  MAILGUN // Mailgun API
}

// ─── WhatsApp Settings ───

model EventWhatsAppSettings {
  id      String @id @default(cuid())
  eventId String @unique

  provider WhatsAppProvider @default(META)
  isActive Boolean          @default(false)

  // Meta Business API
  phoneNumberId      String?
  businessAccountId  String?
  accessToken        String? // Should be encrypted
  webhookVerifyToken String?

  // Templates (must be approved by Meta)
  confirmationTemplate String? // Template name for confirmation
  reminderTemplate     String? // Template name for reminder
  badgeTemplate        String? // Template name for badge delivery

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
}

enum WhatsAppProvider {
  META // Official Meta Business API
  TWILIO // Twilio WhatsApp
  WATI // WATI.io
}

// ─── WhatsApp Logs ───

model WhatsAppLog {
  id        String @id @default(cuid())
  eventId   String
  contactId String

  templateName String
  phoneNumber  String

  status    WhatsAppStatus @default(PENDING)
  messageId String? // From provider

  variables Json? // Template variables sent

  sentAt       DateTime?
  deliveredAt  DateTime?
  readAt       DateTime?
  failedAt     DateTime?
  errorMessage String?

  createdAt DateTime @default(now())

  event   Event   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@index([eventId])
  @@index([contactId])
  @@index([status])
}

enum WhatsAppStatus {
  PENDING
  SENT
  DELIVERED
  READ
  FAILED
}

// ─── Event Branding ───

model EventBranding {
  id      String @id @default(cuid())
  eventId String @unique

  // Colors
  primaryColor    String  @default("#7dc242")
  secondaryColor  String?
  backgroundColor String?
  textColor       String?

  // Logo & Images
  logoUrl        String?
  logoWhiteUrl   String? // For dark backgrounds
  faviconUrl     String?
  headerImageUrl String?

  // Custom CSS
  customCss String? @db.Text

  // Registration Page
  welcomeTitle     String?
  welcomeTitleAr   String?
  welcomeMessage   String? @db.Text
  welcomeMessageAr String? @db.Text

  // Footer
  footerText   String?
  footerTextAr String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
}

// ─── Event Domain ───

model EventDomain {
  id      String @id @default(cuid())
  eventId String @unique

  customDomain String?   @unique // "register.client-event.com"
  isVerified   Boolean   @default(false)
  verifiedAt   DateTime?

  // DNS verification
  verificationRecord String? // TXT record value

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
}

// ─── Contact ───

enum ContactStatus {
  IMPORTED
  INVITED
  REGISTERED
  CANCELLED
}

model Contact {
  id           String        @id @default(cuid())
  eventId      String
  firstName    String
  lastName     String
  email        String
  phone        String?
  organization String?
  designation  String?
  category     String?
  status       ContactStatus @default(IMPORTED)
  inviteToken  String?       @unique
  metadata     Json?
  importBatch  String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  updatedBy    String?

  event        Event         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  registration Registration?
  emailLogs    EmailLog[]
  whatsAppLogs WhatsAppLog[]
  updater      User?         @relation(name: "ContactUpdater", fields: [updatedBy], references: [id])

  @@unique([eventId, email])
  @@index([eventId])
  @@index([eventId, status])
  @@index([email])
  @@index([updatedBy])
}

// ─── Registration ───

model Registration {
  id               String             @id @default(cuid())
  contactId        String             @unique
  eventId          String
  status           RegistrationStatus @default(PENDING)
  registeredAt     DateTime?
  confirmationCode String             @unique @default(cuid())
  formData         Json?
  badgeGenerated   Boolean            @default(false)
  badgeEmailSent   Boolean            @default(false)
  badgeUrl         String?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  // Admin-edit audit-trail. updatedBy is set on every admin-initiated
  // write (Contact PUT, approvals, future admin-replace file flows).
  // Visitor-driven writes (public registration, portal self-edit) leave
  // it null — visitors aren't Users, and a `"portal:<id>"` sentinel
  // would fail the FK. Approval/rejection columns are set by the
  // approval service when the registration enters CONFIRMED/CANCELLED
  // via that path; status changes through other routes (waitlist
  // promotion, portal cancel) leave them null.
  updatedBy        String?
  approvedBy       String?
  approvedAt       DateTime?
  rejectedBy       String?
  rejectedAt       DateTime?
  rejectionReason  String?            @db.Text

  contact          Contact             @relation(fields: [contactId], references: [id], onDelete: Cascade)
  event            Event               @relation(fields: [eventId], references: [id], onDelete: Cascade)
  badge            Badge?
  checkIns         CheckIn[]
  phaseSubmissions PhaseSubmission[]
  phaseAccess      PhaseAccess[]
  portalOtps       PortalOtp[]
  selections       AttendeeSelection[]
  files            RegistrationFile[]
  updater          User?               @relation(name: "RegistrationUpdater", fields: [updatedBy], references: [id])
  approver         User?               @relation(name: "RegistrationApprover", fields: [approvedBy], references: [id])
  rejecter         User?               @relation(name: "RegistrationRejecter", fields: [rejectedBy], references: [id])

  @@index([eventId])
  @@index([status])
  @@index([updatedBy])
  @@index([approvedBy])
}

enum RegistrationStatus {
  PENDING
  PENDING_APPROVAL
  CONFIRMED
  CANCELLED
  WAITLISTED
}

// ─── Check-in Records ───

model CheckIn {
  id             String @id @default(cuid())
  registrationId String
  eventId        String

  checkInTime  DateTime  @default(now())
  checkOutTime DateTime?

  method         CheckInMethod
  location       String? // "Main Entrance", "VIP Gate"
  checkInPointId String?
  deviceId       String? // Device identifier
  checkedInBy    String? // User ID who performed check-in

  notes    String?
  metadata Json?

  registration Registration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  event        Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([registrationId])
  @@index([eventId, checkInTime])
  @@index([eventId])
}

enum CheckInMethod {
  QR_SCAN // QR code scanned
  MANUAL // Manual lookup by staff
  SELF_SERVICE // Self check-in kiosk
  BULK // Bulk check-in
}

// ─── Check-in Points ───

model CheckInPoint {
  id       String  @id @default(cuid())
  eventId  String
  name     String // "Main Entrance", "VIP Gate"
  nameAr   String?
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
}

// ─── Email Template ───

model EmailTemplate {
  id         String            @id @default(cuid())
  eventId    String
  name       String
  type       EmailTemplateType
  subject    String
  bodyHtml   String            @db.Text
  bodyJson   Json?
  headerHtml String?           @db.Text
  footerHtml String?           @db.Text
  variables  String[]
  isDefault  Boolean           @default(false)
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  event          Event           @relation(fields: [eventId], references: [id], onDelete: Cascade)
  campaigns      EmailCampaign[]
  phaseReminders Phase[]         @relation("PhaseReminderTemplate")

  @@index([eventId])
}

enum EmailTemplateType {
  INVITATION
  REMINDER
  CONFIRMATION
  ANNOUNCEMENT
  BADGE_DELIVERY
  CUSTOM
}

// ─── Email Campaign ───

model EmailCampaign {
  id              String              @id @default(cuid())
  eventId         String
  templateId      String
  name            String
  status          EmailCampaignStatus @default(DRAFT)
  scheduledAt     DateTime?
  sentAt          DateTime?
  recipientFilter Json?
  totalRecipients Int                 @default(0)
  sentCount       Int                 @default(0)
  failedCount     Int                 @default(0)
  skippedCount    Int                 @default(0)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  event    Event         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  template EmailTemplate @relation(fields: [templateId], references: [id])
  logs     EmailLog[]

  @@index([eventId])
  @@index([status])
}

enum EmailCampaignStatus {
  DRAFT
  SCHEDULED
  SENDING
  COMPLETED
  FAILED
}

// ─── Email Log ───

model EmailLog {
  id           String         @id @default(cuid())
  campaignId   String?
  contactId    String
  toEmail      String
  subject      String
  status       EmailLogStatus @default(QUEUED)
  sentAt       DateTime?
  openedAt     DateTime?
  errorMessage String?
  resendId     String?
  createdAt    DateTime       @default(now())

  campaign EmailCampaign? @relation(fields: [campaignId], references: [id])
  contact  Contact        @relation(fields: [contactId], references: [id])

  @@index([campaignId])
  @@index([contactId])
  @@index([status])
}

enum EmailLogStatus {
  QUEUED
  SENT
  DELIVERED
  OPENED
  BOUNCED
  FAILED
  SKIPPED
}

// ─── Badge Template ───

model BadgeTemplate {
  id            String   @id @default(cuid())
  eventId       String   @unique
  name          String
  designJson    Json
  width         Int      @default(400)
  height        Int      @default(600)
  backgroundUrl String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  event  Event   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  badges Badge[]
}

// ─── Badge ───

model Badge {
  id             String   @id @default(cuid())
  registrationId String   @unique
  templateId     String
  pdfUrl         String?
  imageUrl       String?
  qrCodeData     String?
  generatedAt    DateTime @default(now())

  registration Registration  @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  template     BadgeTemplate @relation(fields: [templateId], references: [id])
}

// ─── Dynamic Form Fields ───

model FormField {
  id      String @id @default(cuid())
  eventId String
  // Phase→Step ownership (required; backfill populated existing rows,
  // Pass 3 flipped the column to non-nullable).
  stepId  String

  // Field Identity
  name    String // Internal name: "firstName", "country", "dietary"
  label   String // Display label: "First Name"
  labelAr String? // Arabic label: "الاسم الأول"

  // Field Configuration
  type          FieldType
  placeholder   String?
  placeholderAr String?
  helpText      String? // Helper text below field
  helpTextAr    String?

  // Validation
  required   Boolean @default(false)
  validation Json? // {minLength, maxLength, pattern, min, max, customMessage}

  // Options (for SELECT, MULTISELECT, RADIO, CHECKBOX)
  options Json? // [{value: "sa", label: "Saudi Arabia", labelAr: "السعودية"}]

  // Layout
  order   Int        @default(0)
  width   FieldWidth @default(FULL)
  section String? // Group fields: "Personal Info", "Work Details"

  // Conditional Logic
  conditional Json? // {showIf: {field: "attendeeType", operator: "equals", value: "VIP"}}

  // State
  isActive Boolean @default(true)
  isSystem Boolean @default(false) // System fields can't be deleted

  // Metadata
  defaultValue String?
  metadata     Json? // Any additional config

  // Contact column mapping. Null = no mapping; registration endpoint falls
  // back to legacy literal-key destructure (formData["firstName"], etc.).
  // See src/lib/form-builder/field-mapping-labels.ts for UI labels + legacy keys.
  mapsTo FieldMapping?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  event Event              @relation(fields: [eventId], references: [id], onDelete: Cascade)
  step  Step               @relation(fields: [stepId], references: [id], onDelete: Cascade)
  files RegistrationFile[]

  @@unique([eventId, name])
  @@index([eventId, order])
  @@index([eventId, isActive])
  @@index([stepId, order])
}

enum FieldMapping {
  FIRST_NAME
  LAST_NAME
  FULL_NAME
  EMAIL
  PHONE
  ORGANIZATION
  DESIGNATION
}

enum FieldType {
  // Text Inputs
  TEXT
  EMAIL
  PHONE
  TEXTAREA
  NUMBER

  // Selection
  SELECT
  MULTISELECT
  RADIO
  CHECKBOX

  // Date/Time
  DATE
  TIME
  DATETIME

  // Special
  COUNTRY // Pre-populated country list
  PHONE_COUNTRY // Phone with country code
  FILE // File upload
  HIDDEN // Hidden field

  // Layout (non-input)
  HEADING // Section heading
  DIVIDER // Visual separator
  PARAGRAPH // Informational text
}

enum FieldWidth {
  FULL // 100% width
  HALF // 50% width (2 columns)
  THIRD // 33% width (3 columns)
}

// ─── Phase → Step → FormField (multi-page forms + post-reg phases) ───

model Phase {
  id      String    @id @default(cuid())
  eventId String
  type    PhaseType

  title         String
  titleAr       String?
  description   String? @db.Text
  descriptionAr String? @db.Text

  order    Int     @default(0)
  isActive Boolean @default(true)

  // POST_REGISTRATION only (NULL for REGISTRATION type)
  opensAt            DateTime?
  closesAt           DateTime?
  isRequired         Boolean   @default(false)
  reminderSent       Boolean   @default(false)
  reminderTemplateId String? // NULL = no automatic reminder (manual only)

  // Per-category visibility. Empty = visible to every attendee
  // (preserves pre-Stage-2 behaviour). Non-empty = only attendees
  // whose Contact.category is in this list see the phase.
  appliesToCategories String[] @default([])

  // Selectable options (POST_REGISTRATION only — REGISTRATION must keep NONE)
  selectionMode          PhaseSelectionMode @default(NONE)
  maxSelections          Int                @default(1)
  allowChangeAfterSubmit Boolean            @default(false)
  requiresReceiptUpload  Boolean            @default(false) // phase-level default; per-option override on PhaseOption.requiresReceipt

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  event            Event               @relation(fields: [eventId], references: [id], onDelete: Cascade)
  reminderTemplate EmailTemplate?      @relation("PhaseReminderTemplate", fields: [reminderTemplateId], references: [id])
  steps            Step[]
  submissions      PhaseSubmission[]
  accessOverrides  PhaseAccess[]
  options          PhaseOption[]
  selections       AttendeeSelection[]

  @@unique([eventId, order])
  @@index([eventId, type])
}

enum PhaseType {
  REGISTRATION
  POST_REGISTRATION
}

enum PhaseSelectionMode {
  NONE // No options panel — phase behaves identically to today.
  ADMIN_ASSIGNED // Admin picks for everyone. Attendees see read-only.
  ATTENDEE_PICKS // Attendees pick for themselves.
  MIXED // Admin can pre-assign some; rest pick for themselves.
  EXTERNAL_BOOKING // Options informational; attendees book externally and upload receipt.
}

model Step {
  id      String @id @default(cuid())
  phaseId String

  title         String
  titleAr       String?
  description   String? @db.Text
  descriptionAr String? @db.Text

  order Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  phase  Phase       @relation(fields: [phaseId], references: [id], onDelete: Cascade)
  fields FormField[]

  @@unique([phaseId, order])
  @@index([phaseId])
}

model PhaseSubmission {
  id             String @id @default(cuid())
  phaseId        String
  registrationId String

  data        Json
  submittedAt DateTime @default(now())
  updatedAt   DateTime @updatedAt

  phase        Phase        @relation(fields: [phaseId], references: [id], onDelete: Cascade)
  registration Registration @relation(fields: [registrationId], references: [id], onDelete: Cascade)

  @@unique([phaseId, registrationId])
  @@index([registrationId])
  @@index([phaseId])
}

model PhaseAccess {
  id             String @id @default(cuid())
  phaseId        String
  registrationId String

  status     AccessStatus
  unlockedAt DateTime?
  unlockedBy String? // User.id of admin who changed it
  reason     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  phase        Phase        @relation(fields: [phaseId], references: [id], onDelete: Cascade)
  registration Registration @relation(fields: [registrationId], references: [id], onDelete: Cascade)

  @@unique([phaseId, registrationId])
  @@index([registrationId])
}

enum AccessStatus {
  LOCKED // Admin explicitly locked; ignores dates
  OPEN // Admin explicitly unlocked; ignores dates
}

// ─── Portal OTP (one-time code emailed for portal login) ───

model PortalOtp {
  id             String    @id @default(cuid())
  registrationId String
  // HMAC-SHA256(code, AUTH_SECRET) — never store the plain code.
  codeHash       String
  expiresAt      DateTime
  consumedAt     DateTime?
  attempts       Int       @default(0)
  createdAt      DateTime  @default(now())

  registration Registration @relation(fields: [registrationId], references: [id], onDelete: Cascade)

  @@index([registrationId])
  @@index([expiresAt])
}

// ─── Phase Selections (admin-defined option lists per post-reg phase) ───

model PhaseOption {
  id      String @id @default(cuid())
  phaseId String

  label           String
  labelAr         String?
  description     String?  @db.Text
  descriptionAr   String?  @db.Text
  externalUrl     String? // booking link, info link
  capacity        Int? // null = unlimited
  metadata        Json? // free-form: { price, address, checkIn, ... }
  requiresReceipt Boolean? // null = inherit from Phase.requiresReceiptUpload

  // Stage 3 — per-option receipt copy. Rendered above the file picker on
  // the portal upload screen when the option requires a receipt. All four
  // are nullable; when both EN fields are null the upload control renders
  // unchanged. The Ar siblings follow the existing bilingual pattern and
  // are surfaced when the event's multiLanguage module is on.
  receiptLabel          String?
  receiptInstructions   String? @db.Text
  receiptLabelAr        String?
  receiptInstructionsAr String? @db.Text

  order    Int     @default(0)
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  phase      Phase               @relation(fields: [phaseId], references: [id], onDelete: Cascade)
  selections AttendeeSelection[]

  @@unique([phaseId, order])
  @@index([phaseId, isActive])
}

model AttendeeSelection {
  id             String @id @default(cuid())
  phaseId        String
  registrationId String
  optionId       String

  source     SelectionSource
  assignedBy String? // User.id of admin (ADMIN_ASSIGNED) or null (ATTENDEE_PICKED)
  assignedAt DateTime        @default(now())
  notes      String? // admin-only note (never returned to portal)

  receiptFileId String? @unique // 0 or 1 receipt per selection

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  phase        Phase         @relation(fields: [phaseId], references: [id], onDelete: Cascade)
  registration Registration  @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  option       PhaseOption   @relation(fields: [optionId], references: [id], onDelete: Cascade)
  receipt      PhaseReceipt? @relation(fields: [receiptFileId], references: [id], onDelete: SetNull)

  // Multi-pick on a phase means N rows with N different options — never two rows for the same option.
  @@unique([phaseId, registrationId, optionId])
  @@index([phaseId, optionId])
  @@index([registrationId])
}

enum SelectionSource {
  ADMIN_ASSIGNED
  ATTENDEE_PICKED
}

model PhaseReceipt {
  id String @id @default(cuid())

  // Internal Vercel Blob URL. Store is Private — never expose this raw URL
  // in client responses. Reads always go through a server-generated signed URL.
  blobUrl      String
  // Storage key/pathname inside the Blob store; used for signed URL + delete.
  // @unique makes the onUploadCompleted callback race-safe: Vercel retries the
  // webhook up to 5 times if it doesn't get a 200, and the addRandomSuffix
  // pathname is deterministic per upload — so two retries for the same blob
  // hit the unique constraint and the second one no-ops cleanly.
  blobPath     String @unique
  mimeType     String
  sizeBytes    Int
  originalName String // for display ("flight-ticket.pdf")

  uploadedAt DateTime @default(now())
  uploadedBy String // "registration:<id>" for attendee uploads, "admin:<userId>" for admin uploads.

  selection AttendeeSelection?

  @@index([uploadedAt])
}

// ─── Registration File (FILE form field uploads) ───
//
// Parallel to PhaseReceipt but for the public registration flow. Files
// live in Blob before the Registration row is created — the upload
// happens against an unauthenticated visitor session, then the form
// submission links the file to the new registration.
//
// Pre-submission: registrationId IS NULL; uploadSessionId ties the row
// to the visitor's reg_upload_session cookie so they can replace/remove
// before submit. The nightly orphan cleanup deletes rows older than 24h
// that still have a null registrationId.
//
// Post-submission (Stage 2 wiring): registrationId is set; the file
// becomes a permanent record. Deletion of the Registration nulls the
// reference (SetNull) to preserve the file row for cleanup; deletion
// of the FormField cascades to remove its files entirely.
model RegistrationFile {
  id String @id @default(cuid())

  // Becomes non-null on form submission (Stage 2 of the FILE spec).
  // Stage 1 always writes null here.
  registrationId String?
  registration   Registration? @relation(fields: [registrationId], references: [id], onDelete: SetNull)

  // The FormField this file answers. Deletion of the FormField
  // cascades — admin removing a FILE field removes its uploaded files.
  formFieldId String
  formField   FormField @relation(fields: [formFieldId], references: [id], onDelete: Cascade)

  // Ties pre-submission files to the visitor's reg_upload_session
  // cookie. The DELETE endpoint requires this to match before allowing
  // replace/remove on a not-yet-submitted file.
  uploadSessionId String

  // Vercel Blob references. Private mode — never expose blobUrl or
  // blobPath to clients raw. @unique on blobPath makes the
  // onUploadCompleted webhook idempotent: Vercel retries up to 5 times
  // for a 200, and the unique constraint short-circuits the second
  // attempt cleanly. Same anchor as PhaseReceipt.
  blobUrl      String
  blobPath     String @unique
  mimeType     String
  sizeBytes    Int
  originalName String // Display name ("CR_2026.pdf").

  uploadedAt DateTime @default(now())
  uploadedBy String // "session:<id>" pre-submission, "registration:<id>" after.

  @@index([uploadSessionId])
  @@index([registrationId])
  @@index([formFieldId])
  @@index([uploadedAt])
}
